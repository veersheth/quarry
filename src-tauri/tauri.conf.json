{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quarry",
  "version": "0.1.0",
  "identifier": "com.quarry.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "plugins": {
    "cli": {
      "description": "Quarry launcher",
      "args": [
        {
          "name": "toggle",
          "description": "Toggle the launcher window"
        },
        {
          "name": "notepad",
          "description": "Open the notepad window"
        },
        {
          "name": "config",
          "description": "Open the settings window"
        },
        {
          "name": "with",
          "description": "Pre-fill the search input with a query",
          "takesValue": true
        }
      ]
    }
  },
  "app": {
    "windows": [],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
